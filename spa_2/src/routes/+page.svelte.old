<script>
	import {menu, trail, user} from '$lib/js/store.svelte.js';
	import Layout from '$lib/cmp/Layout.svelte';
	import Root from '$lib/cmp/root/Root.svelte';


	const options = [
		{ name:'Infooos', href:'/info' },
		{ name:'Geflügelrassen', href:'/standard' },
		{ name:'Leistungen', href:'/leistung' },
	]
	if( $user && ( $user.moderator || $user.admin ) ) options.push( { name:'Obmann', href:'/obmann' } );
	menu.set( options );

	trail.set( [ {name:'Home', href:'/' } ] );

</script>

<Layout>
	<h1 slot='title' class='title'>
		BDRG Rassegeflügelzuchtbuch
	</h1>

	<div slot='content' class='content'>
		<Root />
	</div>
</Layout>
